# Copy to .env and fill in. Never commit .env.

# Our database (docker compose). Port 5433 avoids clashing with Switch's own Postgres.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://postgres:change-me@localhost:5433/chakshu

# MCP server
MCP_BIND=127.0.0.1:8090

# Switch: the agent bridge URL and the @alert-feed agent's credentials
SWITCH_BRIDGE_URL=
SWITCH_FEED_AGENT_ID=
SWITCH_FEED_API_KEY=
SWITCH_ROOM_ID=

# Models: Google Gemini API (key from Google AI Studio).
# Our Rust code calls Gemini through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768
